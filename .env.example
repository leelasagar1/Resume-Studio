# Copy this file to .env and fill in ONE provider's API key.
# The key stays on your machine; it is never sent to the browser.

# Which provider to use by default: openai | openrouter | claude
AI_PROVIDER=openai

# ---- OpenAI (recommended cheap setup: about $0.02 per run) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini          # keyword extraction from the job; keep at least mini
WRITER_MODEL=                      # bullets, summary, skills (default: OPENAI_MODEL)
REVIEWER_MODEL=                    # factual audit (default: OPENAI_MODEL; gpt-4.1 for stricter)
CHEAP_MODEL=gpt-4.1-nano           # repair/propose; falls back to WRITER_MODEL on bad output

# ---- OpenRouter (optional) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_WRITER_MODEL=
OPENROUTER_REVIEWER_MODEL=
OPENROUTER_CHEAP_MODEL=

# ---- Anthropic Claude (optional) ----
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_WRITER_MODEL=
CLAUDE_REVIEWER_MODEL=
CLAUDE_CHEAP_MODEL=claude-haiku-4-5

# Safety cap on tokens per run (all calls combined).
MAX_RUN_TOKENS=250000
